# ---- WaDesk API, local development without Docker ----
# Copy to apps/api/.env. See the root .env.example for what each value means.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/wadesk
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32 (one for each)
JWT_SECRET=
ENCRYPTION_KEY=

APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Runs the queue workers inside the API process, so one terminal is enough.
EMBEDDED_WORKER=true

STORAGE_DIR=./storage
META_GRAPH_VERSION=v24.0
ALLOW_SIGNUP=true
LOG_LEVEL=debug

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WaDesk <no-reply@localhost>
