# ---- WaDesk with Docker Compose ----
# Copy to .env and fill in. Never commit the real file.

# Database password. Letters and digits only (it goes inside a connection URL).
POSTGRES_PASSWORD=change-me

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts stored WhatsApp tokens. Must be exactly 64 hex characters: openssl rand -hex 32
# Keep a backup: if you lose it, every workspace has to reconnect WhatsApp.
ENCRYPTION_KEY=

# Domains Caddy serves. Point both DNS A records at the server first.
APP_DOMAIN=wadesk.example.com
API_DOMAIN=api-wadesk.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Where people open the web app (no trailing slash). https:// + APP_DOMAIN.
APP_URL=https://wadesk.example.com

# Public address of the API as browsers and Meta reach it (no trailing slash). https:// + API_DOMAIN.
API_PUBLIC_URL=https://api-wadesk.example.com

# The API sits behind Caddy, which is one proxy.
TRUST_PROXY=1

# Login cookie. Leave as is when the web app and API share a parent domain
# (app.example.com and api.example.com). Use "none" only if they are on unrelated domains.
COOKIE_SAMESITE=lax

# Set to false after creating your own workspace if strangers shouldn't be able to sign up.
ALLOW_SIGNUP=true

# Meta Graph API version used for WhatsApp calls.
META_GRAPH_VERSION=v24.0

# Campaign send speed (messages per second, across all workers).
CAMPAIGN_RATE_PER_SECOND=20

# Largest file an agent can send, in MB.
MAX_UPLOAD_MB=16

# Email for password resets and invites. Without SMTP the links are written to the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WaDesk <no-reply@example.com>

LOG_LEVEL=info
